HOME=/home1/jeannot
LIBDIR=$(HOME)/lib
LIB =libio


FCOMPILE = f77 -c -O -e -Nl100
FLINK = f77
FFCOMPILE = f77 -c -0 -e -Nl100 
CCOMPILE = cc -c -O

.f.a:
	${FCOMPILE}  $<
	ar rv $@ $*.o
	rm -f $*.o

.F.a:
	${FFCOMPILE}  $<
	ar rv $@ $*.o
	rm -f $*.o

.c.a:	
	${CCOMPILE} $<
	ar rv $@ $*.o
	rm -f $*.o

