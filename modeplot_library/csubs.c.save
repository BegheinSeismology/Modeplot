{	extern int errno;
	*ierrno=(long)errno;
}

cmkdir_(pname,mode,ires,ierrno)
        long *ires,*ierrno,*mode;
        F_STR pname;
{

        extern int errno, mkdir();
        errno=0;
        *ires=(long) mkdir(F_STRP(pname),(int)(*mode));
