ctrun_(ichan, leng, ierrno)
	long           *ichan, *leng, *ierrno;
{
	extern int      errno, ftruncate();
	int             dummy;
	errno = 0;
	dummy = ftruncate((int) (*ichan), (unsigned long) (*leng));
	*ierrno = (long) errno;
}

