creadlink_(path, pbuf, pnbyt, ires, ierrno)
	F_STR pbuf;
        F_STR path;
	long           *pnbyt, *ires, *ierrno;
{
	extern int      errno, readlink();
	errno = 0;
	*ires = (long) readlink(F_STRP(path) , F_STRP(pbuf), (int) (*pnbyt));
	*ierrno = (long) errno;
}

