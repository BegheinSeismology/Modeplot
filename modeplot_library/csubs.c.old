int mtio(ichan, iop, icnt)
	int ichan, iop, icnt;
{
	extern int      errno, ioctl();
	int             kopt, rc;
	struct mtop     magop;
	struct mtget     magstat;
	switch (iop) {
	case 0:
		kopt = MTWEOF;
		break;
	case 1:
		kopt = MTFSF;
		break;
	case 2:
		kopt = MTBSF;
		break;
	case 3:
		kopt = MTFSR;
		break;
	case 4:
		kopt = MTBSR;
		break;
	case 5:
		kopt = MTREW;
		break;
	case 6:
		kopt = MTOFFL;
		break;
	case 7:
		kopt = MTNOP;
		break;
	default:
		fprintf(stderr, "cmtio: unknown optiion %d", iop);
		exit(2);
		break;
	}
	errno = 0;
	magop.mt_op = kopt;
	magop.mt_count = icnt;
	rc = ioctl( ichan, MTIOCTOP, (char *)&magop) ;
	return ( rc );
}



int setupoas(ichan)
	int ichan;
{
	int iflag = 225, speed=13, word, sword=16384;
	char *dummy;
	(void) ioctl(ichan, TIOCGETP, &pack);
	pack.sg_flags = iflag;
        pack.sg_ispeed=(char)speed;
        pack.sg_ospeed=(char)speed;
	(void) ioctl(ichan, TIOCSETP, &pack);
        (void) ioctl(ichan,TIOCLGET,&word);
	word=sword;
        (void) ioctl(ichan,TIOCLSET,&word);
        (void) ioctl(ichan,TIOCSDTR,0);
	(void) ioctl(ichan, TIOCEXCL, dummy);
	return(0);
}

sendoas(ichan,command,response,lr,iwt,lencom,lenresp)
int ichan, *lr, iwt, lencom, lenresp;
char *command, *response;
{	int arg, ierrno, knt, kntpr, i;
	int nonblocking=1, blocking=0, input=0, output=1, isblocking;
	extern int errno;
	char c, cr=13, nl=10, sp=32, pr=62;
	char *cpt;
	ioctl(ichan,TIOCFLUSH,&input);
	if(iwt > 0)	{ ioctl(ichan, FIONBIO, &nonblocking); isblocking = 0; }
	else 		{ ioctl(ichan, FIONBIO, &blocking);    isblocking = 1; }
        (void)write(ichan,command,lencom); (void)write(ichan,&cr,1);
	ioctl(ichan,TIOCFLUSH,&output);
	if(iwt > 0) 
	{	int isec, msec, mrem, nrep;
		isec= iwt/1000;
		msec= iwt - 1000 * isec;
		nrep=msec/32;
		mrem=msec - 32 * ( nrep );
		if( isec > 0 ) sleep( (unsigned)isec );
		for ( i=0 ; i < nrep ; i++ ) usleep(32000);
		if ( mrem > 0 ) usleep((unsigned)(mrem*1000));
	}
	cpt=response; cpt-- ;
	knt=0; kntpr=0;
	for ( i=0 ; i < 4 ; i++)
	{
		ierrno=0;
		errno=0;
		while(ierrno == 0)
		{	if((read(ichan,&c,1) == 1) )
			{	if( c != cr )
				{	cpt++ ; knt++ ; *cpt = c ;
					if(c == pr) kntpr--;
					else if(c=='<') kntpr++;
				}
			}
			ierrno=errno;
			if( isblocking ) { ioctl(ichan, FIONBIO, &nonblocking); isblocking = 0; }
		}
		if( (ierrno == EWOULDBLOCK ) &  kntpr == -1 ) break;
		if( (ierrno != 0)  ) {  usleep((unsigned)64000) ; } 
	}
	if( knt == 0 ) knt=-1;
	else for (   ; (*cpt == cr | *cpt == sp | *cpt == nl | *cpt == pr) & knt > 0 ; cpt--, knt--) ;
	*lr=knt;
}

statf(ichan, size, istat)
int  ichan, *size, *istat;
{
	extern int      fstat();
	int             dummy;
	dummy = fstat(ichan, &buf);
	*size =  buf.st_size;
	*istat = buf.st_mode;
}

nousleep(a)
unsigned int *a;
{
}
