
c-------------------------------------------------------------------
c-------- Programmed by J. H. Woodhouse ----------------------------
c-------------------------------------------------------------------
      subroutine opnflc(lufl,namein,iap,ifile,irec,istat,lrec,inewi)
c  inew=0 > old
c  inew=1 > new
c  inew=2 > fresh
c  inew=3 > unknown
c  istat=3 > new file exists
c  istat=4 > old file does not exist
c only old and new are legal for tape images on the junkebox
c inew is ignored for mag tape
      character*(*) namein
      character*80 path,name
      character*1 null
      parameter (null=char(0))
      include 'openfile.h'
      common/optdr/ifopt(nlu)
      include 'oasstat.h'
      common/ercod/ierl
      save ifirst
      data ifirst/0/
      integer o20666
      parameter (o20666=6+8*(6+8*(6+8*(0+8*2))))
      ifoaso=0
      inew=inewi
      if(lufl.gt.nluuse) stop 'opnfil: lu out of range'
      ierl=0

      iopt=0
      if(lrec.lt.0) iopt=1
      istat=0
      if(ifirst.eq.0) then
        ifirst=1
        do 20 i=1,nlu
   20   jchn(i)=0
      endif

      if(lufl.le.0) then
        do i=nluuse+1,nlu
          if(jchn(i).eq.0) then
            lufl=i
            goto 71
          endif
        enddo

        stop 'opnfil: no available lu'
   71   continue
      endif
C
      lnamein=istlen(namein)
      if(lnamein.gt.len(opnnam(lufl))) pause 'openflc: name too long'
      opnnam(lufl)=namein(1:lnamein)
      path=namein
      lpath=lnamein
      if(path(1:5).eq.'/opt/') then
        name=path
        lname=istlen(name)
        call oasopen()
        call omount(name(6:lname),inew,istat,path,lpath)
        ifopt(lufl)=1
      else 
       ifopt(lufl)=0
      endif
      if(iap.eq.1.or.iap.eq.5) then
c       read only
        isunop=0
        if(inew.ne.0.and.inew.ne.3) then
          write(0,*) 'opnflc: read only file not old'
          call exit(2)
        endif
        inew=0
      else
c       read/write
        isunop=2
      endif

      if(inew.eq.0.or.inew.eq.3.or.inew.eq.1) then
        call copen(path(1:lpath)//null,jchn(lufl),isunop,ierrno,0,0)
        if(ierrno.ne.0)  then
          if(inew.eq.3.or.inew.eq.1) then
            inew=2
          else
            jchn(lufl)=0
            istat=4
            goto 99
          endif
        else if(inew.eq.1) then
          call cclose(jchn(lufl),ires,ierrno)
          jchn(lufl)=0
          istat=3
          goto 99
        endif
        if(ifopt(lufl).ne.0) itchan=jchn(lufl)
      endif

      if(inew.eq.2) then
        call rcreao(path(1:lpath)//null,jchn(lufl))
      endif
      call fstat(lufl,lent,isuntyp,isize)

c     write(0,'(''sun file mode (octal): '',8r,i10)') isuntyp
      if(isuntyp.eq.o20666) then
        call cstexc(jchn(lufl),ires,ierrno)
        jrecl(lufl)=0
        jfile(lufl)=ifile
        jrec(lufl)=irec
        if(ifile.gt.0)  call cmtio(jchn(lufl),1,ifile,ires,ierrno)
        if(irec.gt.0)  call cmtio(jchn(lufl),3,irec,ires,ierrno)
      else




        jrecl(lufl)=iabs(lrec)
        jfile(lufl)=isuntyp
        if(iopt.eq.1) then
          jfile(lufl)=200
        endif

        jrec(lufl)=irec
        lenglu(lufl)=(isize+jrecl(lufl)-1)/jrecl(lufl)
        if(iap.eq.3.or.iap.eq.5.or.iap.eq.6)
     1     jrec(lufl)=lenglu(lufl)+irec
        jrec(lufl)=max0(0,jrec(lufl))
      endif

   99 continue
      if(ifoaso.ne.0) then
        call oasclose()
        ifoaso=0
      endif
      return
      end
c---------------------------------------------------------------------
        subroutine omount(name,inew,istat,path,lpath)
        character*(*) name,path
        character*1 quote
        parameter (quote='"')
        character*20 oasnam,value
        character*200 mess
        character*1 str1

        include 'oasstat.h'
        lname=istlen(name)
        nbys=1
        do while (nbys.lt.lname.and.name(nbys:nbys).ne.'/')
          nbys=1+nbys
        enddo
        nbys=1+nbys
        nvol=nbys-2
        iuser=-1
        iuser1=-1
        ismounted=0
        do i=1,MXJTAP
          if(jukest(i).ne.6.and.jukest(i).ne.16) then
            iuser1=i-1
            if(oasvols(i).eq.name(1:nvol)) then
              iuser=i-1
              ismounted=1
            endif
          endif
        enddo
        if(iuser.lt.0) iuser=iuser1
        if(iuser.lt.0.or.iuser.gt.9) pause 'omount: invalid user id'
        write(str1,"(i1)") iuser
        call oassend('user/def='//str1,mess,lmess,-1)
        call oassend('offline',mess,lmess,-1)
        call oassend('dismount',mess,lmess,-1)
        call wait(300)
        if(inew.eq.0) then
          oasnam=name(nbys:lname)
          loasnam=lname-nbys+1
          call glinkd(oasnam,value,lvalue,ilstat)
          if(ilstat.ne.1) pause 'opnflc: unexpected status'
          oasnam=value
          loasnam=lvalue
          if(ismounted.eq.0) then
            call oassend('dismount/vol',mess,lmess,-1)
            write(0,*) 'mount '//quote//name(1:nvol)//quote//';'
            call oassend('mount '//quote//name(1:nvol)//quote//';'
     1                ,mess,lmess,-1)
            if(lmess.ne.0) then
              write(0,*) 'From OAS: ',mess(1:lmess)
              call exit(2)
            endif
          endif
          write(0,*) 'mount '//quote//oasnam(1:loasnam)//quote
          call oassend('mount '//quote//oasnam(1:loasnam)//quote
     1                ,mess,lmess,-1)
          if(lmess.ne.0) then
            if(mess(1:21).eq.'E-DMGR-TAPE NOT FOUND') then
              istat=4
              goto 99
            else
              write(0,*) 'From OAS: ',mess(1:lmess)
              call exit(2)
            endif
          endif


        else if(inew.eq.1) then
          if(ismounted.eq.0) then
            call oassend('dismount/vol',mess,lmess,-1)
            write(0,*) 'mount '//quote//name(1:nvol)//quote//';'
            call oassend('mount '//quote//name(1:nvol)//quote//';'
     1                ,mess,lmess,-1)
            if(lmess.ne.0) then
              write(0,*) 'From OAS: ',mess(1:lmess)
              call exit(2)
            endif
          endif
          write(0,*) 'mount/blank '//quote//oasnam(1:loasnam)//quote
          call oassend('mount/blank '//quote//oasnam(1:loasnam)//quote
     1                ,mess,lmess,-1)
          if(lmess.ne.0) then
            if(mess(1:26).eq.'E-OMSG-NAME ALREADY EXISTS') then
              istat=3
              goto 99
            else
              write(0,*) 'From OAS: ',mess(1:lmess)
              call exit(2)
            endif
          endif
        else 
          write(0,*) 'opnflc: illegal inew for a tape image'
          call exit(2)
        endif
        call oassend('online',mess,lmess,-1)
        call wait(1000)
        path='/dev/rst'//tapeid(iuser+1)
        lpath=istlen(path)
   99   continue
        return
        end
